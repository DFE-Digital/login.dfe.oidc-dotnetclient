/*
  This .NET code was originally developed by / 
  and is courtesy of Ramya Athiappan
  
  Intro:
  This configuration file below is important as it provides the credentials 
  for your service to authenticate with DfE Sign-In (DSI).
  It is tailored to call the test environment but can also be used to call 
  all other environments including Production.
  
  Pre-requisites:
  Please ensure you have been given access to the 'sample service' 
  in the Manage Console (https://test-manage.signin.education.gov.uk), or
  your service has been on-boarded and you have permissions to access it.

  Configuration steps:
  1. Login to the DSI Manage Console to obtain values for the following 
  and update the settings below:
  - ClientId
  - ClientSecret
  - APIServiceSecret

  2. Check the values for the following match DSI what is currently 
  setup in the Manage Console:
  - CallbackUrl
  - SignoutCallbackUrl

  3. Set a desired cookie name
  - CookieName

  Finally:
  Your .NET client should now successful integrate with DfE Sign and you will be able to 
  login to DSI using a valid end-user account that exists within the Test environment.

  Help and support:
  For any troubleshooting, feel free to contact the DSI team at #dfe_sign-in slack channel 
  or using the contact us page here https://help.signin.education.gov.uk/contact-us
*/
{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "DfESignInConfig": {
    "UseDfeSignin": true,
    "ClientId": "#ClientId#",
    "ClientSecret": "#ClientSecret#",
    "Authority": "https://test-oidc.signin.education.gov.uk/token",
    "MetaDataUrl": "https://test-oidc.signin.education.gov.uk/.well-known/openid-configuration",
    "CallbackUrl": "/auth/cb",
    "SignoutCallbackUrl": "/signout/complete",
    "SignoutRedirectUrl": "/start/index",
    "Scopes": [ "openid", "email", "profile", "organisation" ],
    "CookieName": "#CookieName#",
    "CookieExpiration": 60,
    "Cryptography": "HMACSHA256",
    "GetClaimsFromUserInfoEndpoint": true,
    "SaveTokens": true,
    "SlidingExpiration": true,
    "APIServiceUrl": "https://test-api.signin.education.gov.uk",
    "APIServiceSecret": "#APIServiceSecret#",
    "APIServiceAudience": "signin.education.gov.uk"
  }
}
