@{
    ViewData["Title"] = "Login";
}
    <div>
        <h1>
            @ViewData["Title"]
        </h1>
        <div class="row">
            <div class="col-md-12">
                <table>
                    @foreach (var claim in Context.User.Claims)
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td><strong>@claim.Value</strong></td>
                        </tr>
                    }
                </table>
            </div>
        </div>


    </div>