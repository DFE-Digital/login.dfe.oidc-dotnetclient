@{
    ViewData["Title"] = "Claims";
}

<div>
	<a class="lnk-home" asp-controller="Start" asp-action="SignOut">Sign-out</a>.
</div>

<h1>Hi @ViewData["Username"]!</h1>
<h1>You have been successfully signed in</h1>

<div>
    @if (Context.User.Identity.IsAuthenticated)
    {
        <div class="row">
            <div class="col-md-12">
                <h1>Users Claims:</h1>
                <table>
                    @foreach (var claim in Context.User.Claims)
                    {
                        <tr>
                            <td>@claim.Type</td>
                            <td><strong>@claim.Value</strong></td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <h1>Tokens:</h1>
                <table>
                    <tr>
                        <td>Id token: </td>
                        <td><strong>@ViewData["IdToken"]</strong></td>
                    </tr>
                    <tr>
                        <td>Access token: </td>
                        <td><strong>@ViewData["AccessToken"]</strong></td>
                    </tr>
                </table>
            </div>
             <div class="col-md-12">
                <h1>API Call result:</h1>
                <table>
                    <tr>
                        <td>User Organizations</td>
                        <td><strong>@ViewData["APICall"]</strong></td>
                    </tr>
                </table>
            </div>
       </div>

       
    }

</div>



